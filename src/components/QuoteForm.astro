---
import { url } from '../lib/path';
import { quoteChoices } from '../content/services';
---
<section class="section quote-section" id="quote"><div class="section-top"><span class="eyebrow">START THE CONVERSATION</span><h2>Tell us what you need.</h2><p>Fill out the request below. This demo creates a sample receipt; it doesn’t send a message or book a job.</p></div>
<form id="quote-form" novalidate><div class="form-notice"><strong>DEMO REQUEST</strong> Use sample details. Photos and text are processed locally and kept in this browser tab. No email, booking or payment is made.</div><div id="error-summary" class="error-summary" role="alert" tabindex="-1" hidden><h3>Check these details</h3><ul></ul></div>
<div class="form-grid"><div class="field"><label for="name">Name <span>(required)</span></label><input id="name" name="name" autocomplete="name" maxlength="80" required aria-describedby="name-error"/><p id="name-error" class="field-error"></p></div><div class="field"><label for="phone">Phone <span>(required)</span></label><input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="25" required aria-describedby="phone-error"/><p id="phone-error" class="field-error"></p></div>
<div class="field field--full"><label for="service">What do you need? <span>(required)</span></label><select id="service" name="service" required aria-describedby="service-error"><option value="">Choose a service</option>{quoteChoices.map(([value,label])=><option value={value}>{label}</option>)}</select><p id="service-error" class="field-error"></p></div>
<div class="field field--full"><label for="vehicle">Vehicle (year, make, model) or load description <span>(required)</span></label><input id="vehicle" name="vehicle" maxlength="200" required aria-describedby="vehicle-error"/><p id="vehicle-error" class="field-error"></p></div>
<div id="transport-fields" class="form-grid field--full" hidden><div class="field"><label for="pickup">Pickup location <span>(required for transport)</span></label><input id="pickup" name="pickup" maxlength="200" aria-describedby="pickup-error"/><p id="pickup-error" class="field-error"></p></div><div class="field"><label for="dropoff">Drop-off location <span>(required for transport)</span></label><input id="dropoff" name="dropoff" maxlength="200" aria-describedby="dropoff-error"/><p id="dropoff-error" class="field-error"></p></div></div>
<div class="field field--full"><label for="preferred">Preferred day / time <span>(optional)</span></label><input id="preferred" name="preferred" maxlength="120" placeholder="For example: weekday afternoon"/></div><div class="field field--full"><label for="message">Anything else we should know? <span>(optional)</span></label><textarea id="message" name="message" rows="4" maxlength="2000"></textarea></div>
<div class="field field--full"><label for="photos">Photos <span>(optional, up to 3)</span></label><p class="caption" id="photos-help">JPEG, PNG or WebP, up to 10 MB each. Demo copies are resized to 1600 px and re-encoded as JPEG to remove image metadata. Originals are never sent.</p><input id="photos" name="photos" type="file" accept="image/jpeg,image/png,image/webp" multiple aria-describedby="photos-help photos-error"/><p id="photos-error" class="field-error"></p><div class="photo-previews" id="photo-previews"></div></div>
<fieldset class="field--full"><legend>How should we reach you? <span>(required)</span></legend><div class="radio-row"><label><input name="contactMethod" type="radio" value="call" checked/> Call</label><label><input name="contactMethod" type="radio" value="text"/> Text</label></div><p id="text-consent" class="caption" hidden>You agree we can text this number about this request (estimate, scheduling, pickup updates) and send one follow-up after the job. No marketing texts. Reply STOP anytime. Demo only: no texts are sent.</p></fieldset></div>
<details class="demo-options"><summary>Presentation tools</summary><label class="checkbox-label"><input id="simulate-failure" type="checkbox"/> Simulate delivery failure to demonstrate retry</label><p class="caption">The failure test preserves entered fields and photos.</p></details>
<div id="form-status" role="status" aria-live="polite"></div><div class="form-actions"><button class="button" type="submit" id="quote-submit">Preview my request <span aria-hidden="true">↗</span></button><span class="caption">Free estimate / no booking or payment</span></div><p class="caption">Read our <a href={url("/privacy/")}>privacy notice</a>. For urgent towing, call <a href="tel:+18132403815">813-240-3815</a>.</p><noscript><p>This form needs JavaScript. Call or text 813-240-3815 to discuss the real job.</p></noscript></form>
<div id="quote-receipt" class="receipt" hidden><span class="eyebrow">DEMO RECEIPT / NOTHING SENT</span><h2 id="receipt-heading" tabindex="-1">Your sample request is ready.</h2><p id="receipt-reference" class="mono"></p><p id="receipt-method"></p><dl id="receipt-details"></dl><div class="actions"><button type="button" id="download-receipt" class="button">Download sample receipt ↓</button><button type="button" id="edit-request" class="button button--outline">Edit request ↗</button></div><p class="caption">This is a demonstration, not a confirmed estimate or appointment. A live request will reach the shop after the delivery integration is configured and tested.</p></div>
<p class="sr-only" role="status" id="transport-announcement"></p><script>import '../scripts/quote';</script></section>

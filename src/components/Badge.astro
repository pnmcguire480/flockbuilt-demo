---
import { url } from '../lib/path';
const { class: className = '', exploded = false } = Astro.props;
const src=url('/brand/flock-built-logo.jpg');
---
{exploded ? <div class:list={['logo-reveal',className]} data-logo-reveal role="img" aria-label="Flock Built Performance supplied logo">
 <img class="logo-original" src={src} width="1080" height="910" alt=""/>
 {[0,1,2,3].map(i=><div class={`logo-pixel-layer logo-pixel-layer--${i}`} aria-hidden="true"><img src={src} width="1080" height="910" alt=""/></div>)}
</div> : <img class:list={['supplied-logo',className]} src={src} width="1080" height="910" alt="Flock Built Performance" decoding="async"/>}

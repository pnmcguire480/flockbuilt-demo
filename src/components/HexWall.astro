---
const cells = Array.from({length: 19}, (_, i) => { const row=Math.floor(i/7),col=i%7;return {x:col*142+70,y:row*123+(col%2)*61+65}; });
---
<svg class="hex-wall" viewBox="0 0 1050 440" fill="none" aria-hidden="true"><g stroke="currentColor" stroke-width="3">{cells.map(({x,y},i)=><g class:list={['hex-unit',{'desktop-cell':i>6}]}><path class="hex-glow" d={`M${x-54},${y-31} L${x},${y-62} L${x+54},${y-31} L${x+54},${y+31} L${x},${y+62} L${x-54},${y+31} Z`}/><path class="hex-cell" data-x={x} data-y={y} d={`M${x-54},${y-31} L${x},${y-62} L${x+54},${y-31} L${x+54},${y+31} L${x},${y+62} L${x-54},${y+31} Z`}/></g>)}</g></svg>

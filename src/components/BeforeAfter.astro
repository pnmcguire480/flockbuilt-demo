---
import { url } from '../lib/path';
import Photo from './Photo.astro';
---
<div class="comparison" data-comparison><div class="comparison-images"><Photo kind="bay" alt="Completed red Civic engine bay with Flock Built valve cover"/><div class="comparison-before"><Photo kind="before" alt="Civic engine bay before the build, with engine removed"/></div><span class="comparison-tag comparison-tag--before">BEFORE</span><span class="comparison-tag comparison-tag--after">AFTER</span><div class="comparison-line" aria-hidden="true"><span>↔</span></div></div><label for="build-comparison">Explore the transformation <span class="caption">Drag or use arrow keys</span></label><input id="build-comparison" type="range" min="0" max="100" value="50" aria-valuetext="50% before photo visible"/></div>

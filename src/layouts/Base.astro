---
import { url } from '../lib/path';
import '../styles/site.css';
import '../styles/correction.css';
import Photo from '../components/Photo.astro';
import displayFont from '@fontsource/barlow-condensed/files/barlow-condensed-latin-800-italic.woff2?url';
import Logo from '../components/Logo.astro';
import site from '../content/site.json';
const { title, description, path = '/', service = 'repair' } = Astro.props;
const canonical = new URL(url(path), 'https://pnmcguire480.github.io').href;
const nav = [['/repair/','The shop'],['/towing/','The road'],['/builds/civic-eg/','The builds'],['/about/','The crew'],['/contact/','Get an estimate']];
const schema = { '@context':'https://schema.org', '@graph': [
  {'@type':'AutoRepair','@id':'https://pnmcguire480.github.io/flockbuilt-demo/#business', name:site.name, telephone:site.phone, url:'https://pnmcguire480.github.io/flockbuilt-demo/', address:{'@type':'PostalAddress',streetAddress:site.street,addressLocality:site.city,addressRegion:site.region,postalCode:site.postalCode,addressCountry:'US'},sameAs:[`https://www.instagram.com/${site.instagram}/`]},
  {'@type':'WebPage','@id':canonical, url:canonical, name:title,description,about:{'@id':'https://pnmcguire480.github.io/flockbuilt-demo/#business'}},
  {'@type':'WebSite','@id':'https://pnmcguire480.github.io/flockbuilt-demo/#website',url:'https://pnmcguire480.github.io/flockbuilt-demo/',name:site.name,alternateName:'Flock Built'}
]};
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#0C0C0C"/><title>{title} | Flock Built Performance</title><meta name="description" content={description}/><meta name="robots" content="noindex, nofollow"/><link rel="canonical" href={canonical}/><link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin/><link rel="icon" href={url("/brand/flock-built-logo.jpg")} type="image/jpeg"/><meta property="og:title" content={`${title} | Flock Built Performance`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://pnmcguire480.github.io/flockbuilt-demo/brand/flock-built-logo.jpg"/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body>
<a class="skip-link" href="#main">Skip to content</a><div class="demo-banner">WEBSITE DEMO <span>•</span> Quote requests are simulated. Nothing is sent. <a href={url("/demo/")}>About this demo &#8599;</a></div>
<header class="header"><a class="brand" href={url("/")} aria-label="Flock Built Performance home"><Logo/></a><nav class="desktop-nav" aria-label="Main navigation">{nav.slice(0,4).map(([href,label]) => <a href={url(href)} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}</nav><div class="header-actions"><a class="header-quote" href={url(`/contact/?service=${service}`)}>GET AN ESTIMATE <span aria-hidden="true">↗</span></a><button class="menu-button" aria-expanded="false" aria-controls="site-menu">MENU <span aria-hidden="true">☰</span></button></div></header>
<dialog id="site-menu" class="menu-dialog" aria-label="Site navigation"><button class="menu-close" aria-label="Close menu">CLOSE ×</button><nav aria-label="Menu">{nav.map(([href,label],i) => <a href={url(href)}><small>0{i+1}</small>{label}<span aria-hidden="true">↗</span></a>)}</nav><p>TAMPA, FL / <a href="tel:+18132403815">813-240-3815</a></p></dialog>
<div class="tire-rail" aria-hidden="true"><span></span></div><main id="main"><slot/></main>
<footer class="footer"><div class="footer-top"><a href={url("/")} aria-label="Flock Built Performance home"><Logo large/></a><div><p>{site.street}<br/>{site.unit}<br/>Tampa, FL 33610</p><p>Gated lot — call ahead for access.</p><a class="text-link" href="tel:+18132403815">813-240-3815 ↗</a></div><nav aria-label="Footer navigation">{nav.map(([href,label]) => <a href={url(href)}>{label}</a>)}<a class="footer-preview" href={url(`https://www.instagram.com/${site.instagram}/`)} target="_blank" rel="noopener">Instagram &#8599;<span class="footer-photo" aria-hidden="true"><Photo kind="bay" alt=""/><small>FROM THE FLOCK BUILT BAY</small></span></a></nav></div><div class="registration"><p>FDACS: <span class="fill-in">{site.fdacsMv}</span></p><p>Transport: <span class="fill-in">{site.usdot}</span></p></div><div class="footer-bottom"><span>© {new Date().getFullYear()} FLOCK BUILT PERFORMANCE</span><span>BUILT ON TRUST. DRIVEN BY PERFORMANCE.</span><div><a href={url("/privacy/")}>Privacy</a><a href={url("/demo/")}>About this demo</a></div></div></footer>
<nav class="mobile-cta" aria-label="Quick contact"><a href="tel:+18132403815">CALL <span aria-hidden="true">↗</span></a><a href="sms:+18132403815">TEXT <span aria-hidden="true">↗</span></a><a href={url(`/contact/?service=${service}`)}>ESTIMATE <span aria-hidden="true">↗</span></a></nav>
<script>import '../scripts/site';</script>
</body></html>

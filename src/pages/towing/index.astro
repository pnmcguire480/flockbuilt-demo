---
import { url } from '../../lib/path';
import Base from '../../layouts/Base.astro';
import HexWall from '../../components/HexWall.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import site from '../../content/site.json';
---
<Base title="24-hour Towing & Vehicle Transport in Tampa Bay" description="24-hour towing, vehicle and equipment transport, local and long-distance hauling from Flock Built Performance. Call 813-240-3815." path="/towing/" service="tow">
<section class="page-hero section towing-hero"><HexWall/><div class="breadcrumbs"><a href={url("/")}>Home</a><span>/</span> Towing & transport</div><span class="eyebrow"><span class="status-dot"></span> 02 / THE ROAD / 24-HOUR TOWING</span><h1>Towing & Vehicle Transport<br/>in Tampa Bay</h1><p class="page-display">MOVE IT.<br/>DELIVER IT.<br/><span>ON TIME.</span></p><p>Fast. Safe. Reliable. Your load, our priority.</p><div class="actions"><a class="button" href="tel:+18132403815">Need a tow? Call now ↗</a><a class="button button--outline" href={url("/contact/?service=tow")}>Request a transport estimate ↗</a></div><p class="caption">For urgent towing, call. The demo form does not dispatch a truck.</p></section>
<section id="transport" class="section"><span class="eyebrow">LOCAL & LONG DISTANCE / FULLY INSURED</span><h2>From A to B.<br/>Handled.</h2><div class="two-grid transport-grid">{[['tow','24-hour towing','Call with your vehicle, pickup location and destination. Confirm availability before arranging a pickup.'],['vehicle-transport','Vehicle transport','Cars, trucks, SUVs and classics. Tell us what needs moving and where it needs to go.'],['equipment-transport','Equipment transport','Construction, farm and heavy equipment. Dimensions and weight help the shop confirm the right setup.'],['hotshot','Hotshot delivery','Small loads and expedited shipments. Discuss your load, route and preferred timing.']].map(([slug,title,copy],i)=><article class="spec-card"><span class="eyebrow">0{i+1} / THE ROAD</span><h3>{title}</h3><p>{copy}</p><a class="text-link" href={url(slug==='hotshot'?'/towing/hotshot/':`/contact/?service=${slug}`)}>Talk transport ↗</a></article>)}</div></section>
<section class="section rig-block"><span class="eyebrow">THE RIG / CLIENT FILL-IN</span><h2>Ready for the real rig.</h2><p class="fill-in">{site.rig}</p><p class="fill-in">Add a real truck and trailer photo here. No stock or composite equipment is presented as the shop’s rig.</p><dl class="inline-facts"><div><dt>REGISTRATION</dt><dd>{site.usdot}</dd></div><div><dt>COVERAGE</dt><dd>{site.serviceArea}</dd></div><div><dt>AFTER-HOURS DROP-OFF</dt><dd>{site.afterHours}</dd></div></dl></section>
<Faq items={[["Can you tow after hours?","24-hour towing is offered. Call to confirm availability and the pickup and drop-off arrangements."],["Can you haul equipment?","Equipment transport is offered. Send the equipment type, dimensions, weight, pickup and destination so the shop can confirm capacity."],["How far do you travel?","Local and long-distance transport are offered. The exact route, coverage and timing are confirmed for each request."],["Where should an after-hours tow go?","Call for drop-off and gate instructions. The facility is gated and the unit and after-hours arrangements still need confirmation."]]}/><Cta service="tow"/>
</Base>

---
import { url } from '../lib/path';
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import Photo from '../components/Photo.astro';
import HexWall from '../components/HexWall.astro';
import HeroPhoto from '../components/HeroPhoto.astro';
import Specials from '../components/Specials.astro';
import ShopFacts from '../components/ShopFacts.astro';
import Cta from '../components/Cta.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { services } from '../content/services';
---
<Base title="Auto & Diesel Repair, Engine Swaps & Towing in Tampa" description="Flock Built Performance in Tampa: auto and diesel repair, engine swaps, 24-hour towing and transport. Call 813-240-3815 for a free estimate.">
<section class="hero"><div class="hero-stage"><HexWall/><HeroPhoto/><div class="hero-copy"><span class="eyebrow"><span class="status-dot"></span> TAMPA, FL / THE SHOP & THE ROAD</span><h1>Auto & Diesel Repair, Engine Swaps<br class="desktop-only"/> & Towing in Tampa, FL</h1><Badge class="hero-badge"/><p class="hero-display">BUILT TO<br/><span>PERFORM.</span><br/>BUILT TO LAST.</p><div class="actions"><a class="button" href="tel:+18132403815">Call 813-240-3815 <span aria-hidden="true">↗</span></a><a class="button button--outline" href={url("/contact/")}>Get a free estimate <span aria-hidden="true">↗</span></a></div><p class="hero-location">6209 N 50TH ST / TAMPA / CALL AHEAD</p></div><div class="hero-bottom"><span>QUALITY WORK. NO SHORTCUTS.</span><a href="#services">EXPLORE THE SHOP <span aria-hidden="true">↓</span></a></div></div></section>
<section class="statement section"><div class="statement-stage"><span class="eyebrow">BUILT ON TRUST. DRIVEN BY PERFORMANCE.</span><h2>We fix it.<br/>We haul it.<br/><span>We build it.</span></h2><div><p class="sr-only">Honest work, fair prices, and a free estimate before we touch a bolt.</p><p class="statement-words" aria-hidden="true">{['Honest','work,','fair','prices,','and','a','free','estimate','before','we','touch','a','bolt.'].map((word,i)=><span class:list={{'accent-word':[0,6,7].includes(i)}}>{word} </span>)}</p><p class="caption">Any separate diagnostic fee is confirmed before work begins.</p></div></div></section>
<section id="services" class="section service-bays"><HexWall/><div class="section-top"><span class="eyebrow">TWO WAYS WE KEEP YOU MOVING</span><h2>In the bay.<br/>On the road.</h2></div><div class="two-grid"><article class="bay-card"><div class="bay-image"><Photo kind="shop" alt="Inside the Flock Built shop, with hex lights and the shop banner"/><span class="eyebrow">01 / REPAIR & PERFORMANCE</span></div><div class="bay-body"><h3>THE SHOP</h3><p>Any mechanic need, handled. From the everyday essentials to your next engine swap.</p><ul>{services.map(s => <li><a href={url(`/repair/${s.slug}/`)}>{s.name}<span aria-hidden="true">↗</span></a></li>)}</ul><a class="text-link" href={url("/repair/")}>Explore repair & performance ↗</a></div></article><article class="bay-card bay-card--road"><div class="road-art" aria-hidden="true"><svg viewBox="0 0 600 330"><path d="M110 330L270 0M490 330L330 0" stroke="currentColor" stroke-width="5"/><path d="M300 290v-55m0-40v-40m0-40V80m0-30V20" stroke="currentColor" stroke-width="6"/></svg><span>24/7</span></div><div class="bay-body"><span class="eyebrow">02 / TOWING & TRANSPORT</span><h3>THE ROAD</h3><p>Fast. Safe. Reliable. Your load, our priority. Local and long-distance hauling.</p><ul><li><a href={url("/towing/")}>24-hour towing ↗</a></li><li><a href={url("/towing/#transport")}>Vehicle & equipment transport ↗</a></li><li><a href={url("/towing/hotshot/")}>Hotshot deliveries ↗</a></li></ul><a class="text-link" href={url("/towing/")}>Explore towing & transport ↗</a></div></article></div></section>
<section class="section trust-row"><article><span class="eyebrow">01 / STRAIGHT TALK</span><h3>Free estimates.</h3><p>Start with a conversation. Confirm the work and any diagnostic fee before booking.</p></article><article><span class="eyebrow">02 / THE WORK</span><h3>Quality comes first.</h3><p>Quality work, fast turnaround. Repair, maintenance and performance work in one shop.</p></article><article><span class="eyebrow">03 / THE ATTITUDE</span><h3>Honest. Reliable.</h3><p>Built on trust. Call or text, tell us what you need, and we’ll talk through the next step.</p></article></section>
<Specials/>
<section class="section featured-build"><div class="section-top"><span class="eyebrow">FROM THE BAY / BUILD 001</span><h2>RED. RAW.<br/><span>FLOCK BUILT.</span></h2><p>One red Civic EG. Before the engine went in, and after the work came together.</p></div><BeforeAfter/><div class="build-caption"><span>HONDA CIVIC EG / TAMPA, FL</span><a class="text-link" href={url("/builds/civic-eg/")}>See the build ↗</a></div></section>
<section class="section crew-preview"><Photo kind="shop" alt="Flock at the shop beneath the Flock Built Performance banner"/><div><span class="eyebrow">THE PEOPLE BEHIND THE WORK</span><h2>Small crew.<br/>All heart.</h2><p>Flock, owner. Jean Carlos, lead mechanic and your main contact at the shop.</p><a class="text-link" href={url("/about/")}>Meet the crew ↗</a></div></section>
<ShopFacts/><Cta/>
</Base>
